# Copy this file to .env for local Packer configuration.
# Authenticate with short-lived credentials, named profiles, or workload identity where possible.
# Never commit .env or service-account key files.

# AWS Packer authentication: prefer AWS_PROFILE or an attached IAM role.
AWS_PROFILE=REPLACE_WITH_YOUR_PROFILE
AWS_REGION=us-east-1

# Google Cloud Packer configuration
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_YOUR_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
PACKER_VAR_project_id=REPLACE_WITH_YOUR_PROJECT_ID
